# RackStats environment template — placeholders only. Never commit real values.
#
# Staging (npm run dev / build:staging / preview:staging):
#   copy this file to .env.staging.local and fill in the staging values.
#   The app refuses to start unless the URL is the staging project.
#
# Live (npm run dev:live / build / preview) reads .env.local, which needs only
#   VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY for the live project.
#
# Only PUBLISHABLE keys (sb_publishable_...) belong here. Never use a secret or
# service_role key in any .env file used by the browser app.

VITE_APP_ENV=staging
VITE_SUPABASE_PROJECT_REF=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
